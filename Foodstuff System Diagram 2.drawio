    <mxGraphModel dx="1717" dy="1043" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Professional Theme Styling\n    classDef startEnd fill:#0F2C59,stroke:#0A1D3A,stroke-width:2px,color:#FFF;\n    classDef baseline fill:#F2F4F4,stroke:#7F8C8D,stroke-width:1.5px,color:#2C3E50;\n    classDef userPortal fill:#F0F4FA,stroke:#1A5F7A,stroke-width:1.5px,color:#0F2C59;\n    classDef process fill:#EBF5FB,stroke:#2980B9,stroke-width:1.5px,color:#2C3E50;\n    classDef decision fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,color:#78350F;\n    classDef backorder fill:#FFF5F5,stroke:#A71D2A,stroke-width:1.5px,color:#A71D2A;\n    classDef storage fill:#E8F8F5,stroke:#16A085,stroke-width:1.5px,color:#117A65;\n\n    %% Entry Points\n    Start([🚚 Supplier Arrives with Foodstuffs]) :::startEnd\n\n    %% Data Ingestion Block\n    subgraph Ingestion [\&quot;📥 DATA INGESTION ENGINE\&quot;]\n        style Ingestion fill:#FAFAFA,stroke:#7F8C8D,stroke-width:1.5px\n        OptionA[Manual Input: Type Approved Quantities] :::process\n        OptionB[Excel Upload/Paste: Monthly Market Order] :::process\n        AlignTable[System Parser: Build Baseline Data Matrix Lots 1-5] :::process\n    end\n\n    %% Role-Based Workflows\n    subgraph Portals [\&quot;📱 MOBILE-FIRST ROLE WORKFLOWS (HTML/CSS/JS)\&quot;]\n        style Portals fill:#F4F7FB,stroke:#1A5F7A,stroke-width:1.5px\n        Dietary[🍳 Dietary Service Portal:&lt;br/&gt;Inspects Food Quality &amp; Freshness] :::userPortal\n        OD[👮 Officer of the Day OD/EOD Portal:&lt;br/&gt;Counts, Weighs &amp; Logs Quantities] :::userPortal\n        Admin[💼 Administrative Service Dashboard:&lt;br/&gt;Manage Records &amp; Review Auto-populated Fields] :::userPortal\n    end\n\n    %% Validation &amp; System Logic\n    subgraph Logic [\&quot;⚙️ FIREBASE BACKEND VALIDATION LOGIC\&quot;]\n        style Logic fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px\n        VerifyCaps{Does actual delivery count&lt;br/&gt;match approved reference quantites?} :::decision\n        FlagShortage[🚨 Record Delivery Variance:&lt;br/&gt;Log Undelivered Quantity] :::backorder\n        FulfillQueue[📌 Hold as Pending Backorder Record&lt;br/&gt;for Future Delivery Cycles] :::backorder\n    end\n\n    %% Storage &amp; Output Block\n    subgraph DataStorage [\&quot;💾 CLOUD FIRESTORE STORAGE &amp; DOCUMENTS\&quot;]\n        style DataStorage fill:#E8F8F5,stroke:#16A085,stroke-width:1.5px\n        DB[(Cloud Firestore:&lt;br/&gt;Active Logs, Backorders &amp; Activity Buffers)] :::storage\n        GenDocs[Populate Reference Values for:&lt;br/&gt;Inspection &amp; Acceptance Report - IAR&lt;br/&gt;Requisition &amp; Issue Slip - RIS] :::storage\n    end\n\n    End([🏁 Processing Completed]) :::startEnd\n\n    %% Operational Process Connections\n    OptionA &amp; OptionB --&gt; AlignTable\n    AlignTable --&gt; |Establishes Reference Quantities &amp; Unit Prices| VerifyCaps\n    \n    Start --&gt; Dietary\n    Dietary --&gt; |Passes Quality Inspection| OD\n    OD --&gt; |Inputs Actual Delivery Quantity| Admin\n    Admin --&gt; |Submits to Database Engine| VerifyCaps\n    \n    %% Decision Trees\n    VerifyCaps --&gt; |Shortage / Missing Items Detected| FlagShortage\n    VerifyCaps --&gt; |Delivery Matches or Clears Backorders| DB\n    \n    FlagShortage --&gt; FulfillQueue\n    FulfillQueue --&gt; |Save Pending Fulfillment Request| DB\n    \n    DB --&gt; GenDocs\n    GenDocs --&gt; End\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="v2MbW4uLmEhXesHzeSIQ-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
