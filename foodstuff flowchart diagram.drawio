        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% DSWD Brand Styling\n    classDef startEnd fill:#0F2C59,stroke:#0A1D3A,stroke-width:2px,color:#FFF;\n    classDef dietary fill:#F0F4FA,stroke:#1A5F7A,stroke-width:1.5px,color:#0F2C59;\n    classDef security fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,color:#D97706;\n    classDef admin fill:#FFF5F5,stroke:#A71D2A,stroke-width:1.5px,color:#A71D2A;\n    classDef system fill:#F9FAFB,stroke:#7F8C8D,stroke-width:1.5px,color:#2C3E50;\n    classDef dswdRed fill:#A71D2A,stroke:#7A111A,stroke-width:1.5px,color:#FFF;\n    classDef dswdBlue fill:#1E40AF,stroke:#1D4ED8,stroke-width:1.5px,color:#FFF;\n\n    %% Phase 0: Pre-Delivery Planning\n    subgraph Planning [\&quot;📋 0. PRE-DELIVERY ALLOCATION\&quot;]\n        style Planning fill:#FAFAFA,stroke:#7F8C8D,stroke-width:1.5px,color:#2C3E50\n        DraftMMO[Dietary Service: Drafts Monthly Market Orders - MMO]:::dietary\n    end\n\n    Start([🚚 Supplier Arrives with Delivery]):::startEnd\n\n    %% Phase 1: Dietary Service\n    subgraph PhaseDietary [\&quot;🍳 1. DIETARY SERVICE (Cooks / Nutritionist-Dietitian)\&quot;]\n        style PhaseDietary fill:#F0F4FA,stroke:#1A5F7A,stroke-width:1.5px,color:#0F2C59\n        ReceiveTransmittal[Receive Delivery Transmittal Only]:::dietary\n        InspectQuality[Inspect Physical Quality, Freshness &amp; Expiry]:::dietary\n    end\n\n    %% Phase 2: OD / EOD Verification\n    subgraph PhaseOD [\&quot;👮 2. OFFICER OF THE DAY / EXECUTIVE OD\&quot;]\n        style PhaseOD fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,color:#78350F\n        VerifyQuantity[Count &amp; Weigh Actual Deliveries]:::security\n        SignTransmittal[Sign Delivery Transmittal Only]:::security\n    end\n\n    %% Phase 3: System &amp; Admin Processing\n    subgraph PhaseAdmin [\&quot;💼 3. ADMINISTRATIVE SERVICE\&quot;]\n        style PhaseAdmin fill:#FFF5F5,stroke:#A71D2A,stroke-width:1.5px,color:#A71D2A\n        CollectPapers[Facilitate &amp; Collect DR and SOA Documents]:::admin\n        InputSystem[Encode DR &amp; SOA Data into Monitoring System]:::admin\n        Check{Cross-match against&lt;br/&gt;Approved PR &amp; MMO balances?}:::security\n        \n        %% Variance Paths\n        FlagOver[🚨 Excess / Wrong Items:&lt;br/&gt;Reject &amp; Return to Supplier]:::dswdRed\n        \n        %% Order Status Check\n        DeliveryStatus{Is delivery complete&lt;br/&gt;per MMO requirement?}:::security\n        \n        %% Fulfillment &amp; Backorder Loop\n        LogShortage[📝 Log Undelivered Items:&lt;br/&gt;Create Backorder Record]:::dswdRed\n        PendingFulfillment[📌 Hold as Pending Request&lt;br/&gt;for Next Delivery Cycle]:::dswdRed\n        \n        %% Normal Outputs\n        GenIAR[Generate Inspection &amp; Acceptance Report - IAR]:::dswdBlue\n        GenRIS[Generate Requisition &amp; Issue Slip - RIS]:::dswdBlue\n        UpdateLedger[System Ledger updates &amp; Deducts MMO Allocation balance]:::admin\n    end\n\n    End([🏁 Process Complete]):::startEnd\n\n    %% Flow Connections\n    DraftMMO --&gt; |Establishes Baseline Caps| Check\n    DraftMMO --&gt; Start\n    Start --&gt; ReceiveTransmittal\n    ReceiveTransmittal --&gt; InspectQuality\n    InspectQuality --&gt; VerifyQuantity\n    VerifyQuantity --&gt; SignTransmittal\n    SignTransmittal --&gt; CollectPapers\n    CollectPapers --&gt; InputSystem\n    InputSystem --&gt; Check\n    \n    %% Decision Routes\n    Check --&gt;|Exceeds Allocation / Wrong Spec| FlagOver\n    Check --&gt;|Valid Baseline Data| GenIAR\n    \n    FlagOver --&gt; |Return to Supplier| Start\n    \n    GenIAR --&gt; GenRIS\n    GenRIS --&gt; DeliveryStatus\n    \n    %% Completion Logic\n    DeliveryStatus --&gt;|Shortage / Missing Items| LogShortage\n    DeliveryStatus --&gt;|100% Fully Delivered| UpdateLedger\n    \n    LogShortage --&gt; PendingFulfillment\n    PendingFulfillment --&gt; |Queue for Future Fulfillment Request| UpdateLedger\n    UpdateLedger --&gt; End\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-tSbnq9U5Xa5SR9eakNe-203">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
